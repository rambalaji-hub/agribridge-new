# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL credentials are used only by the Express server. Never use a VITE_ prefix.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agribridge_app
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=agribridge

# Generate a unique random value of at least 32 characters for each environment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
PORT=3000
HOST=127.0.0.1

# Optional public URL of the separately hosted Express API.
# Leave blank when Express serves the frontend locally; set this in Vercel
# to the HTTPS origin of the deployed backend (no trailing slash).
VITE_API_BASE_URL=

# Browser key: intentionally sent to the browser by Vite.
# Restrict by HTTP referrer and enable only Maps JavaScript API and Places API (New).
VITE_GOOGLE_MAPS_API_KEY=replace-with-a-referrer-restricted-browser-key

# Server-only key: used for Geocoding API and Routes API requests.
# Restrict this key to the server's IP address and those APIs. Never use a VITE_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=replace-with-a-server-restricted-key
